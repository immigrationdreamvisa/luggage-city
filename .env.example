# GEMINI_API_KEY: Optional Gemini API key if AI features are later added.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this application is hosted.
APP_URL="MY_APP_URL"

# ADMIN_EMAIL / ADMIN_PASSWORD: Optional server-side administrator credentials.
# When set, these override the first-run setup administrator account.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# SMTP Configuration for Candidate Email OTP Verification:
# Configure these variables to enable live email OTP delivery on /check-offer-letter.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Luggage City Careers <careers@luggagecity.ca>"
